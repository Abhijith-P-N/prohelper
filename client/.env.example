# ──────────────────────────────────────────────────────────────
# SecureSync client — environment (LIVE / real data mode)
# ──────────────────────────────────────────────────────────────

# MUST be "supabase" for live/real-data mode. The app now reads and writes
# real rows in your Supabase project — there is no seeded demo data.
VITE_AUTH_MODE=supabase

# ── Supabase (required) ──
# Create a project at supabase.com, run supabase/schema.sql + seed/seed.sql,
# then copy these from Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: base URL of the deployed Express API (file upload/share flows).
VITE_API_URL=