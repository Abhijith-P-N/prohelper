# Server — SecureSync API (LIVE mode)
# The server verifies Supabase-issued JWTs and reads/writes real rows in your
# Supabase project. Without the keys below it boots but routes return 503.

PORT=4000
NODE_ENV=development

# ── Supabase (required for live) ──
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Object-storage bucket holding encrypted blobs (created automatically)
STORAGE_BUCKET=secure-blobs

# Crypto master key — 64 hex chars, rotate BEFORE production.
JWT_SECRET=change-me-in-production-please
MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
LOG_LEVEL=dev

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30